MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL=muse-spark-1.3
TAU2_DATA_DIR=.context/tau2-bench/data
# BYLAW_EFFORT=low overrides the reasoning effort of every Muse call (cheaper while testing); unset keeps each caller's effort

# Deploy (docker compose): Caddy is the only public entry and asks for HTTP basic auth.
# Make the hash with: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<password>'
# Keep the hash in single quotes: it contains '$', which compose would otherwise interpolate.
BYLAW_BASIC_AUTH_USER=bylaw
BYLAW_BASIC_AUTH_HASH='<bcrypt hash from caddy hash-password>'
# Domain whose DNS points at the server: Caddy gets a certificate for it. Empty: plain HTTP on :80.
BYLAW_DOMAIN=
